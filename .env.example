# Copy to .env and fill in. All keys are optional except where noted.

# Google Maps Platform — enables Places lookups for schools, churches,
# co-tenants, and coffee competitors. Without this the app still runs,
# but those sections will be empty and flagged for manual review.
# Get a key: https://console.cloud.google.com/ (enable Geocoding + Places APIs)
GOOGLE_MAPS_API_KEY=

# US Census API — for MHHI and population density. Free, email signup.
# https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# NYC Open Data app token — optional; avoids rate limits on DOB / school datasets.
# https://data.cityofnewyork.us/profile/edit/developer_settings
NYC_APP_TOKEN=
